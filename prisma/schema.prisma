generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  passwordHash   String
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  authorization  MetaAuthorization?
  pages          AuthorizedPage[]
  actionLogs     ActionLog[]
  actionReceipts ActionReceipt[]
  pluginTokens   PluginAccessToken[]
  oauthCodes     OAuthAuthorizationCode[]
  oauthTokens    OAuthAccessToken[]
  storeConnections StoreConnection[]
  productLinks     ProductLink[]
}

model StoreConnection {
  id                    String        @id @default(uuid())
  userId                Int
  provider              String        @default("SHOPLINE")
  name                  String
  handle                String
  publicStoreUrl        String
  accessTokenCiphertext String        @db.Text
  status                String        @default("ACTIVE")
  lastSyncedAt          DateTime?
  lastError             String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products              ProductLink[]

  @@unique([userId, handle])
  @@index([userId, status])
}

model ProductLink {
  id                String          @id @default(uuid())
  userId            Int
  storeConnectionId String
  productKey        String
  title             String
  productUrl        String
  status            String          @default("ACTIVE")
  sales7d           Int             @default(0)
  salesPrevious7d   Int             @default(0)
  growthRate        Float           @default(0)
  hotScore          Float           @default(0)
  lastSeenAt        DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeConnection   StoreConnection @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)

  @@unique([storeConnectionId, productKey])
  @@index([userId, status, hotScore])
  @@index([storeConnectionId, status, hotScore])
}

model PluginAccessToken {
  id          String    @id @default(uuid())
  userId      Int
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  status      String    @default("ACTIVE")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model OAuthAuthorizationCode {
  id            String    @id @default(uuid())
  userId        Int
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  scopes        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model OAuthAccessToken {
  id               String    @id @default(uuid())
  userId           Int
  clientId         String
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  resource         String
  scopes           String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model MetaOAuthState {
  id         String    @id @default(uuid())
  stateHash  String    @unique
  userId     Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MetaAuthorization {
  id                  String    @id @default(uuid())
  userId              Int       @unique
  facebookUserId      String
  facebookUserName    String?
  userTokenCiphertext String    @db.Text
  grantedScopes       String
  status              String    @default("ACTIVE")
  tokenExpiresAt      DateTime?
  authorizedAt        DateTime  @default(now())
  lastVerifiedAt      DateTime?
  updatedAt           DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthorizedPage {
  id                  String    @id @default(uuid())
  userId              Int
  pageId              String
  pageName            String
  category            String?
  tasks               String
  pageTokenCiphertext String    @db.Text
  canRead             Boolean   @default(false)
  canPublish          Boolean   @default(false)
  canManageComments   Boolean   @default(false)
  status              String    @default("ACTIVE")
  authorizedAt        DateTime  @default(now())
  lastVerifiedAt      DateTime?
  updatedAt           DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId, status])
}

model ActionReceipt {
  id          String   @id @default(uuid())
  userId      Int
  action      String
  key         String
  requestHash String
  resultJson  Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, key])
  @@index([userId, createdAt])
}

model ActionLog {
  id           String   @id @default(uuid())
  userId       Int
  action       String
  pageId       String?
  status       String
  requestJson  Json?
  resultJson   Json?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
