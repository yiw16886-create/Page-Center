DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional: when omitted or shorter than 32 characters, a separate session key is securely derived from TOKEN_ENCRYPTION_KEY.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-on-first-deploy
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
APP_ORIGIN=http://localhost:3000
# 用户可在全局设置中加密保存账号级 Gateway Token；以下仅作为部署环境后备。
# Vercel 也可使用自动注入的 OIDC Token，本地可继续使用 OPENAI_API_KEY 兼容。
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3000
